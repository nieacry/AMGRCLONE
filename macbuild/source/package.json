{
  "name": "cloudlane",
  "version": "0.15.6",
  "private": true,
  "description": "Multi-account Dropbox desktop client powered by rclone",
  "author": "Cloudlane contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "build:native": "node scripts/generate-icon.mjs && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test:native": "node scripts/native-smoke.mjs && node scripts/provider-smoke.mjs",
    "release:stage": "npm run build:native && npm run build && node scripts/release.mjs stage",
    "release:publish": "node scripts/release.mjs publish",
    "version:next": "node scripts/release.mjs next",
    "test:subst": "node scripts/subst-smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "test:recycle": "node scripts/recycle-smoke.mjs"
  },
  "build": {
    "appId": "app.cloudlane.desktop",
    "productName": "AMG rclone UI",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": ".runtime/package"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "native/bin/app.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": ".runtime/tools/rclone.exe",
        "to": "bin/rclone.exe"
      },
      {
        "from": "native/bin/amg-cloud.exe",
        "to": "bin/amg-cloud.exe"
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
